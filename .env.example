SECRET_KEY=change-me
DATABASE_URL=sqlite:///meridian.db
FLASK_APP=app
FLASK_DEBUG=1

# --- Optional: AI assistant intelligence (Groq) ---------------------------
# The assistant works WITHOUT this — rules handle order/constraint/suggestion
# questions and constraint parsing offline. Set a Groq key ONLY to handle
# free-form questions and unusual phrasings the rules can't. Facts still come
# from the engine; the model only interprets language and phrases answers.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
